# Copy this file to .env and fill it in. .env is gitignored, never commit it.

# Required. The server needs this to talk to Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Optional, and almost never needed. Your own site can always call its own API,
# and so can any machine on your network. This is only for letting some other
# domain in. Comma separated.
ALLOWED_ORIGINS=

# Optional. Leave both blank and the app saves to the browser only, with no
# accounts and no leaderboard. Fill them in to turn accounts on.
# Supabase dashboard, Settings, API. The anon key is safe in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
